// Styling adapted from Tailwind Button Component
let make = props =>
  <button
    {...props}
    className="block cursor-pointer p-1 bg-rescript-500 text-white font-medium text-sm leading-tight uppercase rounded shadow-md hover:bg-rescript-600 hover:shadow-lg focus:bg-rescript-700 focus:shadow-lg focus:outline-none focus:ring-0 active:bg-rescript-700 active:shadow-lg transition duration-150 ease-in-out"
  />
